# 复制本文件为项目根目录的 .env 后填入你的真实密钥：
#     cp .env.example .env        （Windows 直接手动复制改名即可）
#
# 该文件只提交"格式"，不提交真实值；.env 已被 .gitignore 排除，不会被 push。
# 也完全可以不用 .env，直接设置同名环境变量（见 README 快速开始）。

# 通义千问 DashScope API Key（ChatTongyi / DashScopeEmbeddings 都读这一个）
DASHSCOPE_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
